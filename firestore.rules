rules_version = '2';

// MaestroTrack Firestore security rules.
//
// These live in the repo so there is a history of them. They are NOT wired
// to `firebase deploy` — there is deliberately no firebase.json listing
// them — because the authoritative copy is still the one in the Firebase
// console, and a stray deploy overwriting it with a stale file is a worse
// failure than having to paste.
//
// To apply: Firebase console -> Firestore Database -> Rules -> paste ->
// Publish. Then update this file in the same commit as any change.
//
// The governing idea: a student owns their data, and a teacher may read
// the data of students who have joined their studio. Nobody writes
// anything on anyone else's behalf, and a student can never mark their own
// work approved.
//
// What this changes from the previous rules:
//
//  - Teachers could not read anything belonging to a student. /users
//    allowed reading only your own profile, so listing your students was
//    rejected outright, as was looking a teacher up by studio code. The
//    teacher side could not have worked.
//  - A student could update any field of their own assignment, status
//    included, so they could mark their own work approved.
//  - Collections not named were already denied by default; that is now
//    explicit.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMe(userId) {
      return signedIn() && uid() == userId;
    }

    // Reads the student's profile to see whether they belong to this
    // teacher's studio. One document read per evaluation, cached within a
    // request — acceptable because the alternative is denormalising a
    // teacherId onto every session and recording, which then has to be
    // kept correct forever.
    function teaches(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.teacherId == uid();
    }

    /**
     * Is this profile change a legitimate one?
     *
     * `allow update: if isMe(userId)` let a student rewrite any field of
     * their own profile — tested, and all four worked: promote themselves
     * to teacher, point teacherId at any teacher they liked, invent a
     * studio code. The last of those is the serious one, because pointing
     * teacherId at a studio makes you a classmate, and classmates can read
     * each other's practice figures. The studio code flow was decorative.
     *
     * So: role never changes after the account is created, a teacher's own
     * studio code is fixed, and a student may only attach themselves to a
     * teacher whose code they can actually produce — which is exactly what
     * the join screen already sends.
     */
    function validProfileChange() {
      let d = request.resource.data;
      let before = resource.data;
      return d.role == before.role
        // Nobody joins a studio by writing to their own profile any more.
        // Joining is a request the teacher accepts, and accepting is the
        // teacher's write — see the accept clause under /users. So both
        // studio fields are simply frozen against their owner's own hand,
        // for teachers and students alike. An earlier version let a
        // student set teacherId as long as they could produce a matching
        // code, which is precisely the "anyone holding the code walks in"
        // behaviour the invitation flow replaces.
        && d.get('teacherId', null) == before.get('teacherId', null)
        && d.get('studioCode', '') == before.get('studioCode', '');
    }

    function isTeacher() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'teacher';
    }

    /**
     * Is this student waiting on *me*?
     *
     * A get rather than a query, which rules cannot do — the request id is
     * `${studentId}_${teacherId}` precisely so this lookup is possible.
     * That shape also caps a student at one open request per teacher.
     */
    function pendingRequestFrom(studentId) {
      let p = /databases/$(database)/documents/studioRequests/$(studentId + '_' + uid());
      return exists(p)
        && get(p).data.status == 'pending'
        && get(p).data.teacherId == uid();
    }

    /** Nobody's student yet. */
    function inNoStudio() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.get('teacherId', null) == null;
    }

    /** An invitation that is this teacher's, unspent, and still in date. */
    function inviteOpen(token, teacherId) {
      let p = /databases/$(database)/documents/studioInvites/$(token);
      return token != ''
        && exists(p)
        && get(p).data.teacherId == teacherId
        && get(p).data.status == 'open'
        && get(p).data.expiresAt > request.time;
    }

    /**
     * Exactly one item added to a list, with what was already there kept.
     *
     * Allowing a student to write `submissions` at all meant they could
     * replace the array outright — erasing an earlier attempt and the
     * evidence of what a teacher had already seen. A resubmission should
     * add to the record, not rewrite it.
     */
    function appendsOne(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return after.size() == before.size() + 1
        && (before.size() == 0 || before[before.size() - 1] in after);
    }

    /**
     * The name on a leaderboard row has to be the writer's own.
     *
     * studioStats carries a displayName so the leaderboard can be drawn
     * from one query instead of a profile read per classmate. Nothing
     * checked it, so a student could publish their row under a classmate's
     * name and appear twice in their own studio's table.
     *
     * Guarded by exists(): a student whose profile document is missing is
     * already invisible to classmates and teachers, because both paths to
     * their row need that document, so refusing the write as well costs
     * nothing.
     */
    function nameMatchesProfile(d) {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && d.get('displayName', '')
           == get(/databases/$(database)/documents/users/$(uid())).data.get('displayName', '');
    }

    /** The studio the signed-in user belongs to, or null. */
    function myTeacherId() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.teacherId
        : null;
    }

    /* ── profiles ────────────────────────────────────────────────── */
    match /users/{userId} {
      // Invitations resolve by exact document id; teacher profiles stay private.
      allow read: if isMe(userId)
                  || (signedIn() && resource.data.teacherId == uid());

      // A new account may never arrive already attached to a studio;
      // otherwise the update rules below are trivially avoided by setting
      // teacherId at signup instead. There is no exception now that
      // joining runs through a request a teacher accepts: a brand new
      // account has nobody to have accepted it yet.
      allow create: if isMe(userId)
                    && (!('teacherId' in request.resource.data)
                        || request.resource.data.teacherId == null);

      // Only ever your own profile, and not every field of it — see
      // validProfileChange, which is what stops a student walking into a
      // studio uninvited.
      allow update: if isMe(userId) && validProfileChange();

      // A teacher accepting a student who asked to join.
      //
      // The only place in these rules where one person writes to another
      // person's profile, so it is as narrow as it can be made:
      //
      //  - the student must be in no studio at all. Without that clause a
      //    teacher holding a stale request could pull a student out of a
      //    colleague's studio.
      //  - the new teacherId must be the teacher doing the writing, so
      //    nobody hands a student to someone else.
      //  - a pending request addressed to this teacher must exist, which
      //    is the student's half of the handshake and cannot be forged:
      //    the request id embeds the student's own uid.
      //  - three fields, and no others.
      allow update: if signedIn()
                    && resource.data.get('teacherId', null) == null
                    && request.resource.data.get('teacherId', '') == uid()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['teacherId', 'studioName', 'updatedAt'])
                    && pendingRequestFrom(userId);

      // A teacher letting a student go.
      //
      // The Remove button on the students page writes `teacherId: null` to
      // the student's own profile, which no rule permitted: profile writes
      // required isMe(), and the teacher is not the student. The button has
      // never worked. Found by running the app's own function rather than a
      // query written to match the rule.
      //
      // Narrow on purpose: only a teacher this student is actually attached
      // to, only to detach them, and only those fields. A teacher cannot
      // claim a student this way, because the new teacherId must be null.
      // `.get` rather than `.teacherId`: a student who has never joined a
      // studio has no such field, and reading a missing field is an
      // evaluation error. Firestore treats that error as a denial, so the
      // rule was safe but noisy, and a clause that errors is a clause
      // nobody can reason about.
      allow update: if signedIn()
                    && resource.data.get('teacherId', '') == uid()
                    && request.resource.data.get('teacherId', null) == null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['teacherId', 'studioCode', 'studioName', 'updatedAt']);

      allow delete: if false;
    }

    /* ── joining a studio ────────────────────────────────────────── */
    //
    // One invitation per student, spent once, and the teacher still has
    // to accept. Three collections: the invitation the link points at,
    // the short code that points at the invitation, and the request the
    // student raises by spending it.

    match /studioInvites/{token} {
      // The one genuinely public read in these rules, and deliberate: the
      // person a link was sent to has no account yet, so there is nobody
      // to be signed in as. The token is 16 random bytes and is the whole
      // secret; the document holds a teacher's name and a studio's name
      // and nothing else, which is exactly what the invited person is
      // meant to see. Gettable by id, never enumerable — the same shape
      // /shares already runs.
      allow get: if true;
      allow list: if false;

      allow create: if signedIn() && isTeacher()
                    && request.resource.data.teacherId == uid()
                    && request.resource.data.status == 'open'
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    // Nothing mints a year-long invitation by accident.
                    && request.resource.data.expiresAt < request.time + duration.value(14, 'd');

      // Spent by the student who used it, burnt by the teacher who sent
      // it. Either way it leaves 'open' and never comes back: an
      // invitation is good exactly once.
      allow update: if signedIn()
                    && resource.data.status == 'open'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'updatedAt'])
                    && (
                         (resource.data.teacherId == uid()
                          && request.resource.data.status == 'revoked')
                         || request.resource.data.status == 'claimed'
                       );
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      // Six characters is short enough to read out and short enough to
      // grind, so unlike the invitation itself this one wants a signed-in
      // reader: the spoken code is for somebody already in the app, and
      // the link is the path for somebody who is not. A lucky guess still
      // only earns a request the teacher has to accept.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isTeacher()
                    && request.resource.data.teacherId == uid();
      allow update, delete: if false;
    }

    match /studioRequests/{requestId} {
      allow get: if signedIn()
                 && (resource.data.studentId == uid() || resource.data.teacherId == uid());
      // Both sides list their own: the teacher to answer them, the
      // student to see they are waiting.
      allow list: if signedIn()
                  && (resource.data.teacherId == uid() || resource.data.studentId == uid());

      // Raised by the student, and only by spending a live invitation
      // from the teacher they name. The id must embed their own uid,
      // which is what stops anyone raising a request on another
      // student's behalf — and what lets the accept clause above find
      // this document without a query.
      allow create: if signedIn()
                    && requestId == uid() + '_' + request.resource.data.teacherId
                    && request.resource.data.studentId == uid()
                    && request.resource.data.status == 'pending'
                    && inviteOpen(request.resource.data.inviteToken,
                                  request.resource.data.teacherId);

      // The teacher's answer, once, to a request still waiting.
      allow update: if signedIn()
                    && resource.data.teacherId == uid()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'decidedAt']);

      // Asking a second time.
      //
      // There is one document per student-teacher pair, because the id is
      // what lets the accept clause find it without a query. The cost is
      // that a second ask lands on the first one — so without this, being
      // removed from a studio, or declined once, locked a student out of
      // that teacher permanently. Found by using the app, not by reading
      // the rule.
      //
      // Only over a request that has been answered: a pending one belongs
      // to the teacher looking at it, and letting a student swap the
      // invitation underneath them buys nothing.
      allow update: if signedIn()
                    && resource.data.studentId == uid()
                    && request.resource.data.studentId == uid()
                    && resource.data.status in ['accepted', 'declined']
                    && request.resource.data.status == 'pending'
                    && inviteOpen(request.resource.data.inviteToken,
                                  request.resource.data.teacherId)
                    && requestId == uid() + '_' + request.resource.data.teacherId
                    // Already somebody's student: re-asking would put a row
                    // in front of a teacher that the accept clause would
                    // then refuse, which is a worse answer than no row.
                    && inNoStudio();

      // A student changing their mind. Theirs to withdraw, nobody else's.
      allow delete: if signedIn() && resource.data.studentId == uid();
    }

    /* ── a student's own practice data ───────────────────────────── */
    //
    // Nobody but the student reads any of this — not even their teacher.
    //
    // A practice session carries the thoughts pad, where someone writes
    // that a piece is awful and they are sick of it. A rule cannot withhold
    // one field: a reader gets the whole document or none of it. So the
    // teacher gets none of it, and sees rolled-up figures instead, which is
    // all their charts ever used.
    match /practiceSessions/{id} {
      allow read: if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isMe(resource.data.userId);
    }

    match /pieces/{id} {
      allow read: if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isMe(resource.data.userId);
    }

    match /performances/{id} {
      allow read: if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isMe(resource.data.userId);
    }

    // Recordings carry a download URL that works for anyone holding it, so
    // this rule is what actually decides who can hear a take.
    //
    // A teacher hears only what was handed in. Students record freely while
    // practising — bad takes, false starts, things they would never share —
    // and sharedWithTeacher is set on the ones attached to a submission,
    // and only those.
    match /recordings/{id} {
      allow read: if isMe(resource.data.userId)
                  || (resource.data.sharedWithTeacher == true
                      && teaches(resource.data.userId));
      allow create: if isMe(request.resource.data.userId);
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isMe(resource.data.userId);
    }

    /* ── rolled-up practice ──────────────────────────────────────── */
    //
    // Two documents, because they have two audiences, and a rule governs a
    // whole document. Both are written by the student's own app.

    // What a teacher sees: per-day totals and a category breakdown. Enough
    // for every chart on their page, and carrying no notes, no piece names
    // and no individual sessions.
    match /practiceSummary/{userId} {
      allow read: if isMe(userId) || teaches(userId);

      // The uid inside the document has to be the document's own id.
      // Readers take it on trust — useTeacherData keys its chart data by
      // it — so a row claiming to be somebody else's is a row that
      // misattributes practice to them.
      allow write: if isMe(userId)
                   && request.resource.data.get('uid', userId) == userId;
    }

    // What classmates see: how long someone practised each day, their name
    // and their streak. Nothing about what they practised.
    //
    // The studio check reads the viewer's own profile; the teacherId on the
    // document is what makes a leaderboard a single query rather than a
    // read of everyone's profile.
    match /studioStats/{userId} {
      allow read: if isMe(userId)
                  || teaches(userId)
                  || (signedIn()
                      && resource.data.teacherId != null
                      && resource.data.teacherId == myTeacherId());

      // The studio written here must be the one the profile actually says.
      // Without this, claiming a studio in your own figures puts you in its
      // leaderboard regardless of who your teacher is.
      allow write: if isMe(userId)
                   && request.resource.data.get('uid', userId) == userId
                   && nameMatchesProfile(request.resource.data)
                   && (!('teacherId' in request.resource.data)
                       || request.resource.data.teacherId == null
                       || request.resource.data.teacherId == myTeacherId());
    }

    /* ── assignments ─────────────────────────────────────────────── */
    match /assignments/{id} {
      allow read: if signedIn()
                  && (resource.data.studentId == uid() || resource.data.teacherId == uid());

      // Only a teacher creates work, and only in their own name.
      allow create: if signedIn()
                    && request.resource.data.teacherId == uid()
                    && teaches(request.resource.data.studentId);

      // The teacher who set it may change anything about it.
      allow update: if signedIn() && resource.data.teacherId == uid();

      // The student may hand work in — and nothing else.
      //
      // This is the rule that matters most in the whole file. Without the
      // affectedKeys constraint a student could set status to 'approved'
      // and mark their own work complete; without pinning the status value
      // they could do it through this same path. They also must not edit
      // the brief, the due date, the target, or the teacher's feedback.
      allow update: if signedIn()
                    && resource.data.studentId == uid()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'submissions', 'updatedAt'])
                    && request.resource.data.status == 'submitted'
                    && appendsOne('submissions');

      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── teacher's notes about a student ─────────────────────────── */
    // The student can read what is written about them. Deliberate: notes a
    // student may not see belong somewhere other than the app they log in to.
    match /teacherNotes/{id} {
      // The app queries these by studentId alone, so a teacher reading a
      // student's notes is not identifiable from the query's filters. The
      // teaches() lookup is what makes it permissible — it depends only on
      // studentId, which the query does pin.
      allow read: if signedIn()
                  && (resource.data.studentId == uid()
                      || resource.data.teacherId == uid()
                      || teaches(resource.data.studentId));
      // teaches() as well as ownership: without it any teacher could write
      // a note about any child in the system, and the student would read
      // it, since students can see what is written about them.
      allow create: if signedIn()
                    && request.resource.data.teacherId == uid()
                    && teaches(request.resource.data.studentId);
      allow update, delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── lesson schedule ─────────────────────────────────────────── */
    match /lessonSlots/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid() || resource.data.studentId == uid());
      // Same reasoning as teacherNotes: a lesson is an appointment with a
      // particular child, not something to put in a stranger's calendar.
      allow create: if signedIn()
                    && request.resource.data.teacherId == uid()
                    && teaches(request.resource.data.studentId);
      allow update, delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── published share links ───────────────────────────────────── */
    //
    // A share link is public on purpose: it exists to be pasted into a
    // chat, and the crawler that draws the preview is nobody, signed in as
    // nobody. So `get` is open.
    //
    // `list` is not open. Open `get` plus open `list` would let anyone walk
    // every share anyone has ever published. Listing is allowed only where
    // the rule can prove every result belongs to the caller, which means a
    // query filtered on ownerId — that is what the Shared links screen
    // does. A stranger can only fetch a slug they were given, and the slug
    // is 22 characters of crypto-random rather than a session id.
    //
    // The document holds a ShareFields object and nothing else — the same
    // allowlist the image card has always been drawn from, which is what
    // keeps session notes and studio codes out of it. The shape is checked
    // here too, so a client cannot publish a field the type forbids.
    match /shares/{slug} {
      allow get: if true;
      allow list: if isMe(resource.data.ownerId);

      allow create: if isMe(request.resource.data.ownerId)
                    && validShare(request.resource.data);

      // Never. A share that could change after publication would let
      // someone send an innocuous link and swap its contents afterwards,
      // and every platform that cached the preview would still show the
      // old one. Delete and publish again instead.
      allow update: if false;

      allow delete: if isMe(resource.data.ownerId);
    }

    function validShare(d) {
      return d.keys().hasOnly(['ownerId', 'kind', 'fields', 'createdAt', 'image'])
        && d.keys().hasAll(['ownerId', 'kind', 'fields', 'createdAt'])
        && d.kind in ['session', 'badge', 'streak', 'week']
        && d.createdAt is string
        // The preview picture, which the share page renders. Pinned to
        // this project's own bucket: the page puts this straight into an
        // og:image tag, so an arbitrary URL here would be someone else's
        // picture published under this person's name.
        && (!('image' in d.keys())
            || (d.image is string
                && d.image.matches('https://firebasestorage.googleapis.com/.*')
                && d.image.size() < 1000))
        && validShareFields(d.fields);
    }

    /**
     * The allowlist, restated where it is enforced.
     *
     * src/lib/share/fields.ts decides what may leave the device; this is
     * the same list, checked by the server, because a rule that trusts the
     * client to have used the right type is not a rule.
     */
    function validShareFields(f) {
      return f.keys().hasOnly(['minutes', 'dateLabel', 'name', 'streakDays',
                               'pieceTitle', 'category', 'week', 'badgeId', 'badgeLabel'])
        && f.get('minutes', 0) is int
        && f.get('dateLabel', '') is string
        && f.get('name', '') is string
        && f.get('name', '').size() <= 80
        && f.get('pieceTitle', '') is string
        && f.get('pieceTitle', '').size() <= 120
        && f.get('category', '') is string
        && f.get('badgeId', '') is string
        && f.get('badgeLabel', '') is string;
    }

    // Anything not named above is denied. New collections have to be
    // granted access deliberately rather than inheriting it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── Known weakness, recorded rather than hidden ─────────────────────
//
// Studio codes are discoverable. Joining a studio looks a teacher up by
// studioCode, which requires signed-in users to be able to read teacher
// profiles, so a determined user could enumerate them and join a studio
// uninvited.
//
// The fix is a separate collection keyed by the code — a `studioInvites`
// type already exists in src/types and is unused — so the lookup becomes a
// single document read and no profile is exposed. That is a change to the
// working join flow, so it is written down here rather than done quietly.
