rules_version = '2';

// MaestroTrack Firestore security rules.
//
// This file is the authoritative copy. firebase.json points the emulator
// at it, and it is published with:
//
//   npx firebase deploy --only firestore:rules,storage --project maestrotrack-3c2cf
//
// The --project flag is required on purpose: the default project is the
// local-only 'demo-maestrotrack', so a bare deploy has no real target.
// Every change is tested against the emulator (npm run test:rules) first.
//
// The governing idea: a student owns their data, and a teacher may read
// the data of students who have joined their studio. Nobody writes
// anything on anyone else's behalf, and a student can never mark their own
// work approved.
//
// What this changes from the previous rules:
//
//  - Teachers could not read anything belonging to a student. /users
//    allowed reading only your own profile, so listing your students was
//    rejected outright, as was looking a teacher up by studio code. The
//    teacher side could not have worked.
//  - A student could update any field of their own assignment, status
//    included, so they could mark their own work approved.
//  - Collections not named were already denied by default; that is now
//    explicit.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMe(userId) {
      return signedIn() && uid() == userId;
    }

    // Reads the student's profile to see whether they belong to this
    // teacher's studio. One document read per evaluation, cached within a
    // request — acceptable because the alternative is denormalising a
    // teacherId onto every session and recording, which then has to be
    // kept correct forever.
    function teaches(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.teacherId == uid();
    }

    /**
     * Is this profile change a legitimate one?
     *
     * `allow update: if isMe(userId)` let a student rewrite any field of
     * their own profile — tested, and all four worked: promote themselves
     * to teacher, point teacherId at any teacher they liked, invent a
     * studio code. The last of those is the serious one, because pointing
     * teacherId at a studio makes you a classmate, and classmates can read
     * each other's practice figures. The studio code flow was decorative.
     *
     * So: role never changes after the account is created, the studio
     * fields are frozen against their owner (joining is a request the
     * teacher accepts — see /users below), and league standing is the
     * league server's alone.
     */
    function validProfileChange() {
      let d = request.resource.data;
      let before = resource.data;
      return d.role == before.role
        // Nobody joins a studio by writing to their own profile any more.
        // Joining is a request the teacher accepts, and accepting is the
        // teacher's write — see the accept clause under /users. So both
        // studio fields are simply frozen against their owner's own hand,
        // for teachers and students alike. An earlier version let a
        // student set teacherId as long as they could produce a matching
        // code, which is precisely the "anyone holding the code walks in"
        // behaviour the invitation flow replaces.
        //
        // Walking out is the exception, and only ever outwards: teacherId
        // may be cleared by its owner but never set, so leaving is yours
        // and joining still is not.
        && (d.get('teacherId', null) == before.get('teacherId', null)
            || d.get('teacherId', null) == null)
        && d.get('studioCode', '') == before.get('studioCode', '')
        // Your league tier, room and results are the league server's to
        // write, never yours — otherwise anyone could promote themselves.
        // leagueSeen and leagueOptOut stay yours.
        && d.get('league', null) == before.get('league', null);
    }

    function isTeacher() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'teacher';
    }

    /**
     * Is this student waiting on *me*?
     *
     * A get rather than a query, which rules cannot do — the request id is
     * `${studentId}_${teacherId}` precisely so this lookup is possible.
     * That shape also caps a student at one open request per teacher.
     */
    function pendingRequestFrom(studentId) {
      let p = /databases/$(database)/documents/studioRequests/$(studentId + '_' + uid());
      return exists(p)
        && get(p).data.status == 'pending'
        && get(p).data.teacherId == uid();
    }

    /** Nobody's student yet. */
    function inNoStudio() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.get('teacherId', null) == null;
    }

    /** An invitation that is this teacher's, unspent, and still in date. */
    function inviteOpen(token, teacherId) {
      let p = /databases/$(database)/documents/studioInvites/$(token);
      return token != ''
        && exists(p)
        && get(p).data.teacherId == teacherId
        && get(p).data.status == 'open'
        && get(p).data.expiresAt > request.time;
    }

    /**
     * Exactly one item added to a list, with what was already there kept.
     *
     * Allowing a student to write `submissions` at all meant they could
     * replace the array outright — erasing an earlier attempt and the
     * evidence of what a teacher had already seen. A resubmission should
     * add to the record, not rewrite it.
     */
    // A session's or take's `date` is the 'yyyy-MM-dd' string that every
    // reader in the app takes the day from. One saved as a Timestamp, by
    // code that never shipped, made those reads throw and took the whole
    // app down. So a write must leave it a string — or, on an update,
    // leave it as it was, so an older document stays editable.
    function dateStaysAString() {
      return request.resource.data.get('date', null) is string
        || (resource != null
            && request.resource.data.get('date', null) == resource.data.get('date', null));
    }

    function appendsOne(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return after.size() == before.size() + 1
        && after.hasAll(before);
    }

    /**
     * The name on a leaderboard row has to be the writer's own.
     *
     * studioStats carries a displayName so the leaderboard can be drawn
     * from one query instead of a profile read per classmate. Nothing
     * checked it, so a student could publish their row under a classmate's
     * name and appear twice in their own studio's table.
     *
     * Guarded by exists(): a student whose profile document is missing is
     * already invisible to classmates and teachers, because both paths to
     * their row need that document, so refusing the write as well costs
     * nothing.
     */
    function nameMatchesProfile(d) {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && d.get('displayName', '')
           == get(/databases/$(database)/documents/users/$(uid())).data.get('displayName', '');
    }

    /** The studio the signed-in user belongs to, or null. */
    function myTeacherId() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.teacherId
        : null;
    }

    /* ── profiles ────────────────────────────────────────────────── */
    match /users/{userId} {
      // Invitations resolve by exact document id; teacher profiles stay private.
      allow read: if isMe(userId)
                  || (signedIn() && resource.data.teacherId == uid());

      // A new account may never arrive already attached to a studio;
      // otherwise the update rules below are trivially avoided by setting
      // teacherId at signup instead. There is no exception now that
      // joining runs through a request a teacher accepts: a brand new
      // account has nobody to have accepted it yet.
      allow create: if isMe(userId)
                    && (!('teacherId' in request.resource.data)
                        || request.resource.data.teacherId == null)
                    // Nor already holding a league tier.
                    && !('league' in request.resource.data);

      // Only ever your own profile, and not every field of it — see
      // validProfileChange, which is what stops a student walking into a
      // studio uninvited.
      allow update: if isMe(userId) && validProfileChange();

      // A teacher accepting a student who asked to join.
      //
      // The only place in these rules where one person writes to another
      // person's profile, so it is as narrow as it can be made:
      //
      //  - the student must be in no studio at all. Without that clause a
      //    teacher holding a stale request could pull a student out of a
      //    colleague's studio.
      //  - the new teacherId must be the teacher doing the writing, so
      //    nobody hands a student to someone else.
      //  - a pending request addressed to this teacher must exist, which
      //    is the student's half of the handshake and cannot be forged:
      //    the request id embeds the student's own uid.
      //  - three fields, and no others.
      allow update: if signedIn()
                    && resource.data.get('teacherId', null) == null
                    && request.resource.data.get('teacherId', '') == uid()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['teacherId', 'studioName', 'teacherName', 'updatedAt'])
                    && pendingRequestFrom(userId);

      // A teacher letting a student go.
      //
      // The Remove button on the students page writes `teacherId: null` to
      // the student's own profile, which no rule permitted: profile writes
      // required isMe(), and the teacher is not the student. The button has
      // never worked. Found by running the app's own function rather than a
      // query written to match the rule.
      //
      // Narrow on purpose: only a teacher this student is actually attached
      // to, only to detach them, and only those fields. A teacher cannot
      // claim a student this way, because the new teacherId must be null.
      // `.get` rather than `.teacherId`: a student who has never joined a
      // studio has no such field, and reading a missing field is an
      // evaluation error. Firestore treats that error as a denial, so the
      // rule was safe but noisy, and a clause that errors is a clause
      // nobody can reason about.
      allow update: if signedIn()
                    && resource.data.get('teacherId', '') == uid()
                    && request.resource.data.get('teacherId', null) == null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['teacherId', 'studioCode', 'studioName', 'teacherName', 'updatedAt']);

      // A teacher keeping their student's copy of the studio's name
      // current. A student cannot read their teacher's profile, so their
      // own carries the studio and teacher name; without this a teacher
      // who named or renamed the studio after a student joined left that
      // student showing the old name for good. Only those fields (and the
      // teacher's photo, as a link to a picture in this app's storage),
      // only on a student who is theirs now, and teacherId stays as it is.
      allow update: if signedIn()
                    && resource.data.get('teacherId', '') == uid()
                    && request.resource.data.get('teacherId', '') == uid()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['studioName', 'teacherName', 'teacherAvatar', 'updatedAt'])
                    && request.resource.data.get('studioName', '') is string
                    && request.resource.data.get('studioName', '').size() <= 120
                    && request.resource.data.get('teacherName', '') is string
                    && request.resource.data.get('teacherName', '').size() <= 120
                    && request.resource.data.get('teacherAvatar', '') is string
                    && request.resource.data.get('teacherAvatar', '').size() <= 2048
                    && request.resource.data.get('teacherAvatar', '').matches('(https://firebasestorage[.]googleapis[.]com/.*|http://(localhost|127[.]0[.]0[.]1):9199/.*)?');

      allow delete: if false;
    }

    /* ── joining a studio ────────────────────────────────────────── */
    //
    // One invitation per student, spent once, and the teacher still has
    // to accept. Three collections: the invitation the link points at,
    // the short code that points at the invitation, and the request the
    // student raises by spending it.

    /**
     * The invitation is spent by this same write.
     *
     * An invitation is meant for one student. Checking only that it was
     * open let a request be raised without spending it, so one forwarded
     * link could carry any number of strangers to the teacher's door, each
     * under whatever name they liked. Now a request stands only if the
     * write that raises it also marks the invitation claimed.
     */
    function inviteSpentNow(token) {
      return getAfter(/databases/$(database)/documents/studioInvites/$(token)).data.status == 'claimed';
    }

    /** After this write, I have a pending request to that teacher, raised with this token. */
    function requestRaisedWith(token, teacherId) {
      let p = /databases/$(database)/documents/studioRequests/$(uid() + '_' + teacherId);
      return existsAfter(p)
        && getAfter(p).data.studentId == uid()
        && getAfter(p).data.status == 'pending'
        && getAfter(p).data.get('inviteToken', '') == token;
    }

    match /studioInvites/{token} {
      // The one genuinely public read in these rules, and deliberate: the
      // person a link was sent to has no account yet, so there is nobody
      // to be signed in as. The token is 16 random bytes and is the whole
      // secret; the document holds a teacher's name and a studio's name
      // and nothing else, which is exactly what the invited person is
      // meant to see. Gettable by id, never enumerable — the same shape
      // /shares already runs.
      allow get: if true;
      allow list: if false;

      allow create: if signedIn() && isTeacher()
                    && request.resource.data.teacherId == uid()
                    && request.resource.data.status == 'open'
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    // Nothing mints a year-long invitation by accident.
                    && request.resource.data.expiresAt < request.time + duration.value(14, 'd');

      // Spent by the student who used it, burnt by the teacher who sent
      // it. Either way it leaves 'open' and never comes back: an
      // invitation is good exactly once.
      //
      // Claiming is only ever the other half of raising a request with
      // this very token, in the same write: holding a link someone else
      // was sent no longer lets you burn it for them.
      allow update: if signedIn()
                    && resource.data.status == 'open'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'updatedAt'])
                    && (
                         (resource.data.teacherId == uid()
                          && request.resource.data.status == 'revoked')
                         || (request.resource.data.status == 'claimed'
                             && requestRaisedWith(token, resource.data.teacherId))
                       );
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      // Six characters is short enough to read out and short enough to
      // grind, so unlike the invitation itself this one wants a signed-in
      // reader: the spoken code is for somebody already in the app, and
      // the link is the path for somebody who is not. A lucky guess still
      // only earns a request the teacher has to accept.
      allow get: if signedIn();
      allow list: if false;
      // A code points at one of your own invitations, written alongside it
      // — never at somebody else's, and never at nothing. The code itself
      // is the app's six characters from its unambiguous alphabet.
      allow create: if signedIn() && isTeacher()
                    && request.resource.data.teacherId == uid()
                    && request.resource.data.keys().hasOnly(['token', 'teacherId', 'expiresAt'])
                    && request.resource.data.token is string
                    && code.matches('[A-Z0-9]{6}')
                    && existsAfter(/databases/$(database)/documents/studioInvites/$(request.resource.data.token))
                    && getAfter(/databases/$(database)/documents/studioInvites/$(request.resource.data.token)).data.teacherId == uid();
      allow update, delete: if false;
    }

    match /studioRequests/{requestId} {
      allow get: if signedIn()
                 && (resource.data.studentId == uid() || resource.data.teacherId == uid());
      // Both sides list their own: the teacher to answer them, the
      // student to see they are waiting.
      allow list: if signedIn()
                  && (resource.data.teacherId == uid() || resource.data.studentId == uid());

      // Raised by the student, and only by spending a live invitation
      // from the teacher they name. The id must embed their own uid,
      // which is what stops anyone raising a request on another
      // student's behalf — and what lets the accept clause above find
      // this document without a query.
      allow create: if signedIn()
                    && requestId == uid() + '_' + request.resource.data.teacherId
                    && request.resource.data.studentId == uid()
                    && request.resource.data.status == 'pending'
                    && inviteOpen(request.resource.data.inviteToken,
                                  request.resource.data.teacherId)
                    && inviteSpentNow(request.resource.data.inviteToken);

      // The teacher's answer, once, to a request still waiting.
      allow update: if signedIn()
                    && resource.data.teacherId == uid()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'decidedAt']);

      // Asking a second time.
      //
      // There is one document per student-teacher pair, because the id is
      // what lets the accept clause find it without a query. The cost is
      // that a second ask lands on the first one — so without this, being
      // removed from a studio, or declined once, locked a student out of
      // that teacher permanently. Found by using the app, not by reading
      // the rule.
      //
      // Only over a request that has been answered: a pending one belongs
      // to the teacher looking at it, and letting a student swap the
      // invitation underneath them buys nothing.
      allow update: if signedIn()
                    && resource.data.studentId == uid()
                    && request.resource.data.studentId == uid()
                    && resource.data.status in ['accepted', 'declined']
                    && request.resource.data.status == 'pending'
                    && inviteOpen(request.resource.data.inviteToken,
                                  request.resource.data.teacherId)
                    && inviteSpentNow(request.resource.data.inviteToken)
                    && requestId == uid() + '_' + request.resource.data.teacherId
                    // Already somebody's student: re-asking would put a row
                    // in front of a teacher that the accept clause would
                    // then refuse, which is a worse answer than no row.
                    && inNoStudio();

      // A student changing their mind. Theirs to withdraw, nobody else's.
      allow delete: if signedIn() && resource.data.studentId == uid();
    }

    /* ── a student's own practice data ───────────────────────────── */
    //
    // Nobody but the student reads any of this — not even their teacher.
    //
    // A practice session carries the thoughts pad, where someone writes
    // that a piece is awful and they are sick of it. A rule cannot withhold
    // one field: a reader gets the whole document or none of it. So the
    // teacher gets none of it, and sees rolled-up figures instead, which is
    // all their charts ever used.
    match /practiceSessions/{id} {
      allow read: if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId) && dateStaysAString()
                    && timerFieldsWellFormed();
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && dateStaysAString()
                    && timerFieldsUnchanged();
      allow delete: if isMe(resource.data.userId);
    }

    /**
     * What the practice timer stamps on a session, for the weekly league:
     * `source: 'timer'`, the minutes it measured, and the server's signed
     * ticket. Well-formed when written, and never changed afterwards — so
     * a session typed into the log cannot later be turned into a timed
     * one, nor a timed one stretched. (The ticket itself is checked by
     * the league server; rules cannot verify a signature.)
     */
    function timerFieldsWellFormed() {
      let d = request.resource.data;
      return (!('source' in d) || d.source == 'timer')
        && (!('timedMinutes' in d) || (d.timedMinutes is number && d.timedMinutes >= 0))
        && (!('ticket' in d) || (d.ticket is string && d.ticket.size() < 200));
    }
    function timerFieldsUnchanged() {
      let d = request.resource.data;
      let before = resource.data;
      return d.get('source', null) == before.get('source', null)
        && d.get('timedMinutes', null) == before.get('timedMinutes', null)
        && d.get('ticket', null) == before.get('ticket', null);
    }

    /**
     * Weekly league rooms: read by the players in them, written only by
     * the league server (which bypasses these rules). A room's member map
     * is keyed by uid, so membership is a key lookup.
     */
    match /leagueRooms/{roomId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow write: if false;
    }
    /**
     * League cards: the profile a player in your room opens from the
     * board. Written only by the league server, and only while its owner
     * has "Show my profile to my league" on. Read by its owner and by the
     * players in the room the card names: nobody outside that room.
     */
    match /leagueCards/{userId} {
      allow read: if isMe(userId)
                  || (signedIn()
                      && resource.data.roomId is string
                      && uid() in get(/databases/$(database)/documents/leagueRooms/$(resource.data.roomId)).data.members);
      allow write: if false;
    }
    // The server's own bookkeeping: which room is filling. Nobody else's.
    match /leagueIndex/{id} {
      allow read, write: if false;
    }

    match /pieces/{id} {
      // The student's teacher sees the pieces the student chose to share
      // (and the ones the teacher put there, which are always shared).
      allow read: if isMe(resource.data.userId)
                  || (teaches(resource.data.userId) && resource.data.sharedWithTeacher == true);
      // A teacher may put a new, untouched piece in their own student's
      // Library, marked as theirs and shared; nothing else of the student's.
      allow create: if isMe(request.resource.data.userId)
                    || (teaches(request.resource.data.userId)
                        && request.resource.data.keys().hasOnly([
                             'userId', 'title', 'composer', 'difficulty', 'status',
                             'totalMinutes', 'sessionCount', 'completionPercentage', 'confidenceHistory',
                             'startedAt', 'updatedAt', 'sharedWithTeacher', 'addedBy', 'addedByName'])
                        && request.resource.data.addedBy == 'teacher'
                        && request.resource.data.sharedWithTeacher == true
                        // A fresh piece: nothing practised, nothing mastered.
                        && request.resource.data.status == 'active'
                        && request.resource.data.totalMinutes == 0
                        && request.resource.data.sessionCount == 0
                        && request.resource.data.completionPercentage == 0
                        && request.resource.data.confidenceHistory.size() == 0
                        && request.resource.data.title is string
                        && request.resource.data.title.size() > 0
                        && request.resource.data.title.size() <= 120
                        && request.resource.data.get('composer', '').size() <= 120
                        && request.resource.data.get('addedByName', '').size() <= 120);
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      // Only the student edits a piece.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      // A teacher can take back only a piece they added.
      allow delete: if isMe(resource.data.userId)
                    || (teaches(resource.data.userId) && resource.data.addedBy == 'teacher');
    }

    match /performances/{id} {
      allow read: if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isMe(resource.data.userId);
    }

    // Recordings carry a download URL that works for anyone holding it, so
    // this rule is what actually decides who can hear a take.
    //
    // A teacher hears only what was handed in. Students record freely while
    // practising — bad takes, false starts, things they would never share —
    // and sharedWithTeacher is set on the ones attached to a submission,
    // and only those.
    match /recordings/{id} {
      allow read: if isMe(resource.data.userId)
                  || (resource.data.sharedWithTeacher == true
                      && teaches(resource.data.userId));
      allow create: if isMe(request.resource.data.userId) && dateStaysAString();
      // userId is immutable: handing a record to someone else plants it in
      // their log, where it counts toward their streaks and their totals.
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && dateStaysAString();
      allow delete: if isMe(resource.data.userId);
    }

    /* ── rolled-up practice ──────────────────────────────────────── */
    //
    // Two documents, because they have two audiences, and a rule governs a
    // whole document. Both are written by the student's own app.

    // What a teacher sees: per-day totals and a category breakdown. Enough
    // for every chart on their page, and carrying no notes, no piece names
    // and no individual sessions.
    match /practiceSummary/{userId} {
      allow read: if isMe(userId) || teaches(userId);

      // The uid inside the document has to be the document's own id.
      // Readers take it on trust — useTeacherData keys its chart data by
      // it — so a row claiming to be somebody else's is a row that
      // misattributes practice to them.
      allow write: if isMe(userId)
                   && request.resource.data.get('uid', userId) == userId;
    }

    // Timer-checked minutes per day, written only by the league server
    // (which bypasses these rules). The practice summary above is the
    // student's own app's arithmetic and only as true as the log; this is
    // the figure nobody can type in.
    match /verifiedPractice/{userId} {
      allow read: if isMe(userId) || teaches(userId);
      allow write: if false;
    }

    // How long someone practised each day, their name and their streak.
    //
    // Classmates used to be able to read each other's rows, for a studio
    // leaderboard the app does not show. With nothing on screen to need it,
    // that was every classmate's daily practice readable by every other —
    // and, since the name on a row is whatever its owner calls themselves,
    // a row that could pass for someone else's. Now it is the student's
    // own and their teacher's, like the practice summary.
    match /studioStats/{userId} {
      allow read: if isMe(userId) || teaches(userId);

      // The studio written here must be the one the profile actually says.
      // Without this, claiming a studio in your own figures puts you in its
      // leaderboard regardless of who your teacher is.
      allow write: if isMe(userId)
                   && request.resource.data.get('uid', userId) == userId
                   && nameMatchesProfile(request.resource.data)
                   && (!('teacherId' in request.resource.data)
                       || request.resource.data.teacherId == null
                       || request.resource.data.teacherId == myTeacherId());
    }

    /* ── assignments ─────────────────────────────────────────────── */
    match /assignments/{id} {
      allow read: if signedIn()
                  && (resource.data.studentId == uid() || resource.data.teacherId == uid());

      // Only a teacher creates work, and only in their own name.
      allow create: if signedIn()
                    && request.resource.data.teacherId == uid()
                    && teaches(request.resource.data.studentId);

      // The teacher who set it may change anything about it — except
      // whose it is: moving it to another student would plant it in a
      // stranger's list, and moving it to another teacher hands it away.
      //
      // And only while it is still their student: a teacher the student
      // has left must not go on rewriting work that student still sees.
      // ('' is a student with no account yet — the teacher's own record.)
      allow update: if signedIn()
                    && resource.data.teacherId == uid()
                    && request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.studentId == resource.data.studentId
                    && studentOk(resource.data.studentId);

      // The student may hand work in — and nothing else.
      //
      // This is the rule that matters most in the whole file. Without the
      // affectedKeys constraint a student could set status to 'approved'
      // and mark their own work complete; without pinning the status value
      // they could do it through this same path. They also must not edit
      // the brief, the due date, the target, or the teacher's feedback.
      allow update: if signedIn()
                    && resource.data.studentId == uid()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'submissions', 'updatedAt'])
                    && request.resource.data.status == 'submitted'
                    && appendsOne('submissions')
                    // To the teacher they are with now, not one they left.
                    && resource.data.teacherId == myTeacherId();

      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── teacher's notes about a student ─────────────────────────── */
    // The student can read what is written about them. Deliberate: notes a
    // student may not see belong somewhere other than the app they log in to.
    /* ── messages between a teacher and a student ─────────────────── */
    //
    // Each side reads its own: the student by studentId, the teacher by
    // teacherId — the conversation stays readable to both after a student
    // leaves. Sending is where the relationship is checked: a student only
    // to their current teacher, a teacher only to their own students, each
    // only as themselves. Messages are never edited; the sender may delete
    // their own. A message is text, a shared item, or both.
    function validMessage(d) {
      return d.keys().hasAll(['teacherId', 'studentId', 'from', 'text', 'createdAt'])
        && d.keys().hasOnly(['teacherId', 'studentId', 'from', 'text', 'createdAt', 'attachment'])
        && d.teacherId is string && d.studentId is string
        && d.from in ['teacher', 'student']
        && d.text is string && d.text.size() <= 2000
        && d.createdAt is string
        && (('attachment' in d
              && d.attachment is map
              && d.attachment.keys().hasAll(['kind', 'id'])
              && d.attachment.keys().hasOnly(['kind', 'id'])
              && d.attachment.kind in ['recording', 'assignment']
              && d.attachment.id is string
              && d.attachment.id.size() > 0 && d.attachment.id.size() <= 128)
            || (!('attachment' in d) && d.text.size() > 0));
    }

    match /messages/{id} {
      allow read: if signedIn()
                  && (resource.data.studentId == uid() || resource.data.teacherId == uid());
      allow create: if signedIn()
                    && validMessage(request.resource.data)
                    && ((request.resource.data.from == 'student'
                          && request.resource.data.studentId == uid()
                          && get(/databases/$(database)/documents/users/$(uid())).data.get('teacherId', null)
                               == request.resource.data.teacherId)
                        || (request.resource.data.from == 'teacher'
                          && request.resource.data.teacherId == uid()
                          && teaches(request.resource.data.studentId)));
      allow update: if false;
      allow delete: if signedIn()
                    && ((resource.data.from == 'student' && resource.data.studentId == uid())
                        || (resource.data.from == 'teacher' && resource.data.teacherId == uid()));
    }

    // The old notes, from before lesson notes. Nothing in the app writes
    // or reads these any more, so they are kept, not grown: the student
    // they are about can still read (and export) them, the teacher who
    // wrote them can read or delete them, and nobody adds to them. An
    // earlier clause let any teacher the student later joined read what a
    // previous teacher had written.
    /* ── announcements: one note to the whole studio ───────────────── */
    // Written once by the teacher, read by the students in their studio
    // now — the student's query names the teacher, and the rule checks it
    // is theirs, so a former student stops seeing them. Never edited (post
    // a new one); the teacher takes one down by deleting it.
    match /announcements/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid()
                      || resource.data.teacherId == myTeacherId());
      allow create: if signedIn() && isTeacher()
                    && request.resource.data.keys().hasOnly(['teacherId', 'text', 'createdAt'])
                    && request.resource.data.teacherId == uid()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    match /teacherNotes/{id} {
      allow read: if signedIn()
                  && (resource.data.studentId == uid()
                      || resource.data.teacherId == uid());
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── lesson schedule ─────────────────────────────────────────── */
    match /lessonSlots/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid() || resource.data.studentId == uid());
      // Same reasoning as teacherNotes: a lesson is an appointment with a
      // particular child, not something to put in a stranger's calendar.
      allow create: if signedIn()
                    && request.resource.data.teacherId == uid()
                    && teaches(request.resource.data.studentId);
      allow update: if signedIn()
                    && resource.data.teacherId == uid()
                    && request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.studentId == resource.data.studentId;
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── published share links ───────────────────────────────────── */
    //
    // A share link is public on purpose: it exists to be pasted into a
    // chat, and the crawler that draws the preview is nobody, signed in as
    // nobody. So `get` is open.
    //
    // `list` is not open. Open `get` plus open `list` would let anyone walk
    // every share anyone has ever published. Listing is allowed only where
    // the rule can prove every result belongs to the caller, which means a
    // query filtered on ownerId — that is what the Shared links screen
    // does. A stranger can only fetch a slug they were given, and the slug
    // is 22 characters of crypto-random rather than a session id.
    //
    // The document holds a ShareFields object and nothing else — the same
    // allowlist the image card has always been drawn from, which is what
    // keeps session notes and studio codes out of it. The shape is checked
    // here too, so a client cannot publish a field the type forbids.
    match /shares/{slug} {
      allow get: if true;
      allow list: if isMe(resource.data.ownerId);

      allow create: if isMe(request.resource.data.ownerId)
                    && validShare(request.resource.data);

      // Never. A share that could change after publication would let
      // someone send an innocuous link and swap its contents afterwards,
      // and every platform that cached the preview would still show the
      // old one. Delete and publish again instead.
      allow update: if false;

      allow delete: if isMe(resource.data.ownerId);
    }

    function validShare(d) {
      return d.keys().hasOnly(['ownerId', 'kind', 'fields', 'createdAt', 'image'])
        && d.keys().hasAll(['ownerId', 'kind', 'fields', 'createdAt'])
        && d.kind in ['session', 'badge', 'streak', 'week', 'league', 'recap', 'piece']
        && d.createdAt is string
        // The preview picture, which the share page renders. Pinned to
        // this project's own bucket, and to the owner's own folder in it:
        // the page puts this straight into an og:image tag, so an
        // arbitrary URL here would be someone else's picture published
        // under this person's name. (It used to allow any Firebase
        // project's bucket.)
        && (!('image' in d.keys())
            || (d.image is string
                && d.image.size() < 1000
                && d.image.matches('https://firebasestorage[.]googleapis[.]com/v0/b/maestrotrack-3c2cf[.]firebasestorage[.]app/o/shares%2F'
                                   + d.ownerId + '%2F[A-Za-z0-9]+[.]png([?][A-Za-z0-9=&_.-]*)?')))
        && validShareFields(d.fields)
        // A name on the card is the owner's own, as their profile has it —
        // not anyone they would like a public link to claim to be.
        && (!('name' in d.fields)
            || (exists(/databases/$(database)/documents/users/$(d.ownerId))
                && d.fields.name == get(/databases/$(database)/documents/users/$(d.ownerId)).data.get('displayName', '')));
    }

    /**
     * The allowlist, restated where it is enforced.
     *
     * src/lib/share/fields.ts decides what may leave the device; this is
     * the same list, checked by the server, because a rule that trusts the
     * client to have used the right type is not a rule.
     */
    function validShareFields(f) {
      // Every field bounded: this is a public page, and an unbounded
      // string is a megabyte of whatever someone likes on this domain.
      return f.keys().hasOnly(['minutes', 'dateLabel', 'name', 'streakDays',
                               'pieceTitle', 'category', 'week', 'badgeId', 'badgeLabel',
                               'headline', 'subline'])
        && f.get('minutes', 0) is int
        // A week's share carries the week's total, so up to 7 × 24 h.
        && f.get('minutes', 0) >= 0 && f.get('minutes', 0) <= 10080
        && f.get('dateLabel', '') is string
        && f.get('dateLabel', '').size() <= 60
        && f.get('name', '') is string
        && f.get('name', '').size() <= 80
        && f.get('streakDays', 0) is int
        && f.get('streakDays', 0) >= 0 && f.get('streakDays', 0) <= 100000
        && f.get('pieceTitle', '') is string
        && f.get('pieceTitle', '').size() <= 120
        && f.get('category', '') is string
        && f.get('category', '').size() <= 60
        && f.get('week', []) is list
        && f.get('week', []).size() <= 7
        && f.get('badgeId', '') is string
        && f.get('badgeId', '').size() <= 60
        && f.get('badgeLabel', '') is string
        && f.get('badgeLabel', '').size() <= 80
        // A league result, a month's practice style, a piece learned: the
        // card's own words, bounded like the rest.
        && f.get('headline', '') is string
        && f.get('headline', '').size() <= 80
        && f.get('subline', '') is string
        && f.get('subline', '').size() <= 120;
    }

    /* ══ Teacher studio ═══════════════════════════════════════════════
     *
     * The teacher's own records. Everything here is additions: no rule
     * above was changed for it. The shape of the ideas:
     *
     *  - A teacher owns what they write (teacherId is theirs, and stays).
     *  - A student is only ever named on something by a teacher they are
     *    actually in the studio of (teaches()), and reads only what names
     *    them — and only the notes marked shared.
     *  - Students without an account are roster rows, owned by the teacher.
     */

    function ownsRoster(id) {
      return id is string
        && exists(/databases/$(database)/documents/studioStudents/$(id))
        && get(/databases/$(database)/documents/studioStudents/$(id)).data.teacherId == uid();
    }
    function mine(d) {
      return d.teacherId == uid();
    }
    function keepsOwner() {
      return resource.data.teacherId == uid() && request.resource.data.teacherId == uid();
    }
    // '' or null: no account (yet). Otherwise someone in this teacher's studio.
    function studentOk(u) {
      return u == null || u == '' || teaches(u);
    }

    /* ── who the teacher teaches, account or not ─────────────────────── */
    // Teacher only: the row holds prices and private details.
    match /studioStudents/{id} {
      allow read: if signedIn() && resource.data.teacherId == uid();
      allow create: if signedIn() && mine(request.resource.data)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && studentOk(request.resource.data.get('uid', null));
      // uid may be set (linking the student's account once they join),
      // cleared, or left — never pointed at someone outside the studio.
      allow update: if signedIn() && keepsOwner()
                    && (request.resource.data.get('uid', null) == resource.data.get('uid', null)
                        || studentOk(request.resource.data.get('uid', null)));
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    match /families/{id} {
      allow read: if signedIn() && resource.data.teacherId == uid();
      allow create: if signedIn() && mine(request.resource.data);
      allow update: if signedIn() && keepsOwner();
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    match /studioSettings/{teacherId} {
      allow read: if isMe(teacherId);
      allow write: if isMe(teacherId) && request.resource.data.teacherId == teacherId;
    }

    match /invoices/{id} {
      allow read: if signedIn() && resource.data.teacherId == uid();
      allow create: if signedIn() && mine(request.resource.data);
      allow update: if signedIn() && keepsOwner();
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── the calendar ─────────────────────────────────────────────────
     * A student reads the lessons that name them — from the teacher they
     * are with now, and only from them. A rule cannot check each uid in
     * studentUids at write time, so this is where naming a stranger is
     * made harmless: the stranger cannot read it. (Their query has to
     * filter on teacherId for the same reason.) */
    function myLesson(d) {
      return uid() in d.studentUids && d.teacherId == myTeacherId();
    }
    function lessonShape(d) {
      return d.rosterIds is list && d.rosterIds.size() <= 30
        && d.studentUids is list && d.studentUids.size() <= 30
        && d.startTime is string && d.durationMinutes is number
        && d.durationMinutes > 0 && d.durationMinutes <= 600;
    }
    match /studioLessons/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid() || myLesson(resource.data));
      allow create: if signedIn() && mine(request.resource.data) && lessonShape(request.resource.data);
      allow update: if signedIn() && keepsOwner() && lessonShape(request.resource.data);
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }
    match /lessonOccurrences/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid() || myLesson(resource.data));
      allow create: if signedIn() && mine(request.resource.data) && lessonShape(request.resource.data)
                    && request.resource.data.date is string;
      allow update: if signedIn() && keepsOwner() && lessonShape(request.resource.data);
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── lesson notes: shared or private ──────────────────────────────
     * Private notes exist so a teacher has somewhere to write what a
     * student must not read. The student's read requires visibility
     * 'shared' on the document itself, so their query has to ask for
     * shared notes only — a private one can never be listed or fetched. */
    function noteShape(d) {
      return d.visibility in ['shared', 'private']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 5000
        && d.studentUid is string;
    }
    match /lessonNotes/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid()
                      || (resource.data.studentUid == uid() && resource.data.visibility == 'shared'));
      allow create: if signedIn() && mine(request.resource.data) && noteShape(request.resource.data)
                    && ownsRoster(request.resource.data.rosterId)
                    && studentOk(request.resource.data.studentUid);
      // Only while this is still the student's teacher. A teacher a
      // student has left could otherwise go on rewriting shared notes the
      // student still receives. Deleting stays open, to tidy up.
      allow update: if signedIn() && keepsOwner() && noteShape(request.resource.data)
                    && request.resource.data.rosterId == resource.data.rosterId
                    && studentOk(resource.data.studentUid)
                    && studentOk(request.resource.data.studentUid);
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── practice: the teacher suggests, the student decides ─────────── */
    match /practiceCorrections/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid() || resource.data.studentId == uid());
      allow create: if signedIn() && mine(request.resource.data)
                    && teaches(request.resource.data.studentId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.toMinutes is int
                    && request.resource.data.toMinutes >= 0
                    && request.resource.data.toMinutes <= 1440;
      // The student answers once, and changes nothing else — not the
      // minutes the teacher suggested.
      allow update: if signedIn()
                    && resource.data.studentId == uid()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']);
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    // Practice the teacher records for a student. Read by that student;
    // never counted toward their streak or the league.
    match /teacherPractice/{id} {
      allow read: if signedIn()
                  && (resource.data.teacherId == uid()
                      || (resource.data.studentUid != '' && resource.data.studentUid == uid()));
      allow create: if signedIn() && mine(request.resource.data)
                    && ownsRoster(request.resource.data.rosterId)
                    && request.resource.data.studentUid is string
                    && studentOk(request.resource.data.studentUid)
                    && request.resource.data.minutes is int
                    && request.resource.data.minutes > 0
                    && request.resource.data.minutes <= 600;
      // The same bounds as when it was written: an edit is not a way
      // round them.
      allow update: if signedIn() && keepsOwner()
                    && request.resource.data.rosterId == resource.data.rosterId
                    && request.resource.data.studentUid is string
                    && studentOk(request.resource.data.studentUid)
                    && request.resource.data.minutes is int
                    && request.resource.data.minutes > 0
                    && request.resource.data.minutes <= 600;
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }

    /* ── assignments for a student not on the app yet ─────────────────
     * A second block for the same documents: Firestore allows a request
     * if any matching rule does, so the rules in the assignments block
     * above are untouched and still all apply. These add exactly two
     * things — and studentId '' never matches a student's own query. */
    match /assignments/{id} {
      allow create: if signedIn()
                    && request.resource.data.teacherId == uid()
                    && request.resource.data.studentId == ''
                    && ownsRoster(request.resource.data.get('rosterId', null));
      // Once they join: the work becomes theirs, and nothing else changes.
      allow update: if signedIn()
                    && resource.data.teacherId == uid()
                    && resource.data.studentId == ''
                    && request.resource.data.teacherId == uid()
                    && teaches(request.resource.data.studentId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentId', 'updatedAt']);
    }

    // Anything not named above is denied. New collections have to be
    // granted access deliberately rather than inheriting it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
