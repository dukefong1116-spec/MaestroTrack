{
  "indexes": [
    {
      "comment": "Recent sessions first, bounded. Firestore needs a composite index for an equality filter combined with an order on a different field.",
      "collectionGroup": "practiceSessions",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "date",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "A studio leaderboard: everyone sharing a teacher.",
      "collectionGroup": "studioStats",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "teacherId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "currentStreak",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "A teacher reading handed-in takes. Two equality filters need a composite index.",
      "collectionGroup": "recordings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "sharedWithTeacher",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "A student's own calendar: lessons that name them, from the teacher they are with now (the rules require that teacher filter).",
      "collectionGroup": "studioLessons",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "studentUids",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "teacherId",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "A student's own calendar: lessons that name them, from the teacher they are with now (the rules require that teacher filter).",
      "collectionGroup": "lessonOccurrences",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "studentUids",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "teacherId",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
