rules_version = '2';

// MaestroTrack Storage rules.
//
// Recordings are private, and these rules are what keeps them so.
//
// A take used to be saved with a download URL — a link carrying its own
// access token, which plays for anyone holding it, signed in or not, for
// ever, and bypasses everything written here. Takes are now saved with
// only their path, and played by fetching through the SDK as the signed-in
// person, so every play is checked against the rules below, at the time
// of playing: a take that is un-shared, or a student who leaves the
// studio, is unplayable to the teacher from that moment.
//
// Takes saved before that change still carry their URL in Firestore, and
// those links keep working until their tokens are revoked.

service firebase.storage {
  match /b/{bucket}/o {
    // A take handed in to a teacher. New takes live at
    // recordings/{student}/{recordingId}/{file}, so the recording's own
    // document can be looked up from the path: the teacher may read the
    // file while that document says it was handed in, belongs to this
    // folder's student, and the student is still in their studio — the
    // same three things the Firestore rule on the document asks.
    match /recordings/{userId}/{recordingId}/{fileName} {
      allow read: if request.auth != null
                  && handedInTo(request.auth.uid, userId, recordingId);
    }

    function handedInTo(teacher, student, recordingId) {
      let rec = firestore.get(/databases/(default)/documents/recordings/$(recordingId)).data;
      return rec.userId == student
        && rec.sharedWithTeacher == true
        && firestore.get(/databases/(default)/documents/users/$(student)).data.teacherId == teacher;
    }

    match /recordings/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Size and type bounds so a bug or a bad actor cannot fill the
      // bucket. An hour of practice at the 64kbps the app records is about
      // 30MB, so 200MB is generous without being unbounded.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Profile photos.
    //
    // One object per person at a fixed path, overwritten on each upload, so
    // changing your picture cannot leave the old one behind and the bucket
    // does not grow a file per change.
    //
    // Read is owner-only. That is a narrower gate than it looks: getDownloadURL() hands back a URL carrying its own token, which
    // works for anyone holding it regardless of what is written here. The
    // rule stops someone walking the bucket by path; it does not make a URL
    // you have shared private again.
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Bounded and typed for the same reason the recordings rule is: so a
      // bug or a bad actor cannot fill the bucket, and so nothing that is
      // not an image can be stored where an <img> will point at it. SVG is
      // deliberately absent — it can carry script.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Share card images.
    //
    // The only publicly readable thing in this bucket, and deliberately
    // so: this is the picture a platform's crawler fetches to draw the
    // preview for a share link, and a crawler is nobody, signed in as
    // nobody. Everything else here is owner-only.
    //
    // What makes that safe is what the picture is: a card drawn from
    // ShareFields, which is the allowlist of what may leave the device.
    // The person previewed this exact image before publishing it.
    //
    // Write stays owner-only and the slug is the file name, so one person
    // cannot overwrite another's published card.
    match /shares/{userId}/{slug} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType == 'image/png';

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Nothing else in the bucket is reachable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
